<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- db_server と OpenAI を呼ぶ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 写真でコーデ診断のカメラ（無い端末でも、写真フォルダから選べるので必須にしない） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- usesCleartextTraffic: db_server が http なので許可する（https にしたら false に戻す） -->
    <application android:name=".LayeRoomApplication" android:allowBackup="false" android:icon="@mipmap/ic_layeroom_launcher" android:roundIcon="@mipmap/ic_layeroom_launcher" android:label="@string/app_name" android:theme="@style/AppTheme" android:supportsRtl="true" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:icon="@mipmap/ic_layeroom_launcher" android:label="@string/app_name" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
