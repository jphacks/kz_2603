// コピーして arduino_secrets.h を作る（このファイル名のままでは読み込まれない）
#define SECRET_SSID "your-wifi-ssid"
#define SECRET_PASS "your-wifi-password"
#define SECRET_DEVICE_KEY "change-me-device-key"  // サーバーの .env の DEVICE_API_KEY と同じ値
#define SECRET_SERVER_HOST "192.168.0.10"         // DBサーバーのIPまたはホスト名
#define SECRET_SERVER_PORT 8000
