# コピーして .env を作る: cp .env.example .env

# PostgreSQL
POSTGRES_USER=outfit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=outfit

# APIを公開するポート
API_PORT=8000

# Arduino が X-Device-Key ヘッダで送るキー（起動時にこのキーのセンサーを登録）
DEVICE_API_KEY=change-me-device-key
DEVICE_ROOM_NAME=201教室

# 天気を取る地点（キャンパスの緯度・経度。未決事項：とりあえず東京駅）
WEATHER_LATITUDE=35.681
WEATHER_LONGITUDE=139.767
# 天気の取得間隔（分）
WEATHER_INTERVAL_MINUTES=30
